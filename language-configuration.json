{
  "wordPattern": "(-?\\d*\\.\\d\\w*)|(\\.?[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*)|(\\d\\w*)",
  "comments": {
    "blockComment": ["\n/\n", "\n\\\n"],
    "lineComment": {
      "comment": "/"
    }
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ]
}
